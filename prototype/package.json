{
  "name": "cctv-workspace-design-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared React design prototype and local Python-engine pilot dashboard.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/domain.test.mjs tests/operations-domain.test.mjs tests/camera-layout.test.mjs tests/workflow.test.mjs",
    "test:e2e": "playwright test",
    "test:engine": "playwright test --config playwright.engine.config.js",
    "test:webcam": "playwright test --config playwright.webcam.config.js"
  },
  "dependencies": { "react": "19.3.0", "react-dom": "19.3.0", "lucide-react": "1.55.0" },
  "devDependencies": { "vite": "8.3.4", "@vitejs/plugin-react": "6.1.2", "@playwright/test": "1.64.0" }
}
