  "components": {
    "schemas": {
      "AssignmentInput": {
        "properties": {
          "employee_id": {
            "type": "string",
            "title": "Employee Id"
          },
          "workspace_id": {
            "type": "string",
            "title": "Workspace Id"
          },
          "start_utc_us": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start Utc Us"
          },
          "end_utc_us": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "End Utc Us"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "employee_id",
          "workspace_id",
          "start_utc_us",
          "end_utc_us"
        ],
        "title": "AssignmentInput"
      },
      "CalibrationInput": {
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "WEBCAM_LIVE",
              "RTSP_LIVE"
            ],
            "title": "Source"
          },
          "width": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Height"
          },
          "zones": {
            "items": {
              "$ref": "#/components/schemas/LiveZoneInput"
            },
            "type": "array",
            "maxItems": 16,
            "minItems": 1,
            "title": "Zones"
          },
          "rules": {
            "$ref": "#/components/schemas/LiveRulesInput"
          },
          "camera_key": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "title": "Camera Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "width",
          "height",
          "zones",
          "rules",
          "camera_key"
        ],
        "title": "CalibrationInput"
      },
      "CameraViewInput": {
        "properties": {
          "viewer_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Viewer Id"
          },
          "camera_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 16,
            "title": "Camera Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "viewer_id",
          "camera_ids"
        ],
        "title": "CameraViewInput"
      },
      "EmployeeInput": {
        "properties": {
          "display_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Display Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "display_name"
        ],
        "title": "EmployeeInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LiveRulesInput": {
        "properties": {
          "occupied_confirm_seconds": {
            "type": "number",
            "maximum": 60.0,
            "minimum": 0.1,
            "title": "Occupied Confirm Seconds",
            "default": 2
          },
          "empty_confirm_seconds": {
            "type": "number",
            "maximum": 120.0,
            "minimum": 0.1,
            "title": "Empty Confirm Seconds",
            "default": 5
          },
          "max_evidence_gap_seconds": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.5,
            "title": "Max Evidence Gap Seconds",
            "default": 3
          },
          "association_overlap": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Association Overlap",
            "default": 0.25
          },
          "ambiguity_margin": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Ambiguity Margin",
            "default": 0.1
          },
          "strong_confidence": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Strong Confidence",
            "default": 0.5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "LiveRulesInput"
      },
      "LiveStartInput": {
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "WEBCAM_LIVE",
              "RTSP_LIVE"
            ],
            "title": "Source"
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "preview_only": {
            "type": "boolean",
            "title": "Preview Only",
            "default": false
          },
          "camera_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Camera Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source"
        ],
        "title": "LiveStartInput"
      },
      "LiveStopInput": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "LiveStopInput"
      },
      "LiveZoneInput": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "polygon": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "maxItems": 64,
            "minItems": 3,
            "title": "Polygon"
          },
          "exclusive_group": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Exclusive Group",
            "default": "workstations"
          }
        },
