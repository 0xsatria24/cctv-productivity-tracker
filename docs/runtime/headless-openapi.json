  "components": {
    "schemas": {
      "Calibration": {
        "properties": {
          "width": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Height"
          },
          "camera_key": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Camera Key"
          },
          "zones": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 16,
            "minItems": 1,
            "title": "Zones"
          },
          "rules": {
            "additionalProperties": true,
            "type": "object",
            "title": "Rules"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "width",
          "height",
          "camera_key",
          "zones",
          "rules"
        ],
        "title": "Calibration"
      },
      "CameraInput": {
        "properties": {
          "camera_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$",
            "title": "Camera Id"
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "camera_id",
          "url"
        ],
        "title": "CameraInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
